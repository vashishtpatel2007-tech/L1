# Copy this file to .env and paste ONE key. Everything else is optional.
# .env is git-ignored; nothing here is ever committed.
#
# After pasting, verify it in one command:
#     python scripts/check_provider.py --provider qwen
#
# ── Qwen-VL, hosted (Alibaba Model Studio) ─────────────────────────────
#   Get a key: https://modelstudio.console.alibabacloud.com
#   Free trial quota. Vision + tool calling. Models: qwen-vl-max, qwen-vl-plus
DASHSCOPE_API_KEY=
#   Only if your account is MAINLAND rather than international:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── What ships at the event (organizers supply this) ───────────────────
ANTHROPIC_API_KEY=

# ── Other options, all already wired ───────────────────────────────────
#   https://console.groq.com          free, fastest inference
GROQ_API_KEY=
#   https://aistudio.google.com/apikey   free, daily quota
#   New keys start with AQ. and must be sent as the x-goog-api-key header
#   (already the default). Then: python scripts/check_provider.py --provider gemini
GEMINI_API_KEY=
#   https://openrouter.ai             one key, many models, some free
OPENROUTER_API_KEY=
#   Local via Ollama needs no key:  ollama serve && ollama pull qwen2.5vl:7b
