# Copy to .env and fill what you need. Everything here is OPTIONAL --
# the app boots and demos with this file completely empty.

APP_NAME="Project Name"
TAGLINE="One line a judge remembers"
ENV=dev
SECRET_KEY=change-me-before-demo

# --- LLM providers: set ANY one. Groq is free + fastest for hackathons. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Panic switch: OFFLINE=1 makes every AI path use local fallbacks.
OFFLINE=0

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
